# Copy this file to .env.local and fill it in.
#
# Only NEXT_PUBLIC_* reaches the browser. Do NOT rename anything else to
# NEXT_PUBLIC_* — that would inline it into the JavaScript bundle for anyone to read.

# --- DeepSeek ---
# Get one at https://platform.deepseek.com
DEEPSEEK_API_KEY=sk-your-key-here

# --- App ---
# The origin the app is served from. Used as Better Auth's baseURL on the server
# and by the browser client, so it is the one URL that must be public.
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Signs session cookies and verification tokens. Generate with:
#   openssl rand -base64 32
# Not optional: left unset, Better Auth falls back to a well-known default string
# and session cookies become forgeable.
BETTER_AUTH_SECRET=replace-me

# --- Data stores (docker compose up -d) ---
DATABASE_URL=postgres://whalechat:whalechat_local_dev@localhost:5432/whalechat
REDIS_URL=redis://localhost:6379

# --- Mail (Resend) ---
# https://resend.com/api-keys
# Leave unset locally and verification / reset links are printed to the server
# console instead of being sent.
RESEND_API_KEY=
# Must be on a domain verified at https://resend.com/domains. The resend.dev
# address below needs no verification but only delivers to the account owner.
EMAIL_FROM=WhaleChat <onboarding@resend.dev>

